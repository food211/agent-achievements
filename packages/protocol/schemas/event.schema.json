{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-achievements.dev/schemas/v1/event.schema.json",
  "title": "Agent work event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "event_type", "occurred_at", "source", "actor", "task", "outcome", "evidence"],
  "properties": {
    "schema_version": { "const": "agent-achievements/v1" },
    "event_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$" },
    "event_type": { "$ref": "#/$defs/eventType" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "version"],
      "properties": {
        "system": { "type": "string", "minLength": 1, "maxLength": 80 },
        "version": { "type": "string", "minLength": 1, "maxLength": 40 }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_id"],
      "properties": {
        "agent_id": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "type": { "type": "string", "minLength": 1, "maxLength": 80 }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "summary"],
      "properties": {
        "status": { "enum": ["started", "completed", "failed", "parked", "resumed", "observed"] },
        "summary": { "type": "string", "minLength": 1, "maxLength": 600 }
      }
    },
    "evidence": {
      "type": "array",
      "maxItems": 20,
      "items": { "$ref": "#/$defs/evidence" }
    },
    "extensions": { "type": "object" }
  },
  "$defs": {
    "eventType": {
      "anyOf": [
        {
          "enum": [
            "task.started", "task.completed", "task.failed", "task.parked", "task.resumed",
            "judgment.requested", "judgment.resolved", "verification.completed", "evidence.collected",
            "rule.proposed", "rule.conflict_detected", "rule.revised"
          ]
        },
        { "type": "string", "pattern": "^custom:[a-z0-9][a-z0-9._-]{2,127}$" }
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "ref"],
      "properties": {
        "type": { "enum": ["commit", "test", "screenshot", "decision_record", "impact_summary", "trace", "external"] },
        "ref": { "type": "string", "minLength": 1, "maxLength": 500 },
        "summary": { "type": "string", "maxLength": 400 }
      }
    }
  }
}
