{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-achievements.dev/schemas/v1/prompt-request.schema.json",
  "title": "Prompt injection request sent to a connected Code Agent adapter",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "agent_id", "workspace", "intent", "text", "created_at"],
  "properties": {
    "schema_version": { "const": "agent-achievements/v1" },
    "request_id": { "type": "string", "pattern": "^prompt-[a-z0-9-]{4,80}$" },
    "agent_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "workspace": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "intent": { "enum": ["run_wuxing_diagnostic"] },
    "text": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
