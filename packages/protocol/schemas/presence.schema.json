{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-achievements.dev/schemas/v1/presence.schema.json",
  "title": "Agent presence heartbeat",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "session_id", "agent_id", "runtime", "status", "observed_at", "expires_at"],
  "properties": {
    "schema_version": { "const": "agent-achievements/v1" },
    "session_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "agent_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 80 },
        "version": { "type": "string", "maxLength": 40 }
      }
    },
    "status": { "enum": ["active", "idle", "stopped"] },
    "observed_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "current_task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "summary"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 400 }
      }
    },
    "extensions": { "type": "object" }
  }
}

