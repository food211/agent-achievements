{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-achievements.dev/schemas/v1/achievement-design-request.schema.json",
  "title": "Human request for Agent-assisted achievement design",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "brief", "status", "created_at"],
  "properties": {
    "schema_version": { "const": "agent-achievements/v1" },
    "request_id": { "type": "string", "pattern": "^design-[a-z0-9-]{4,80}$" },
    "agent_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "workspace": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "brief": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "status": { "enum": ["pending", "proposed", "applied"] },
    "created_at": { "type": "string", "format": "date-time" },
    "proposal": { "$ref": "achievement-design-proposal.schema.json" }
  }
}
