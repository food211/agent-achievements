{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-achievements.dev/schemas/v1/context-response.schema.json",
  "title": "Agent achievement context",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "agent_id", "recently_awarded", "tracked", "operating_priority"],
  "properties": {
    "schema_version": { "const": "agent-achievements/v1" },
    "agent_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "recently_awarded": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["achievement_id", "title", "tier", "points", "human_feedback", "evidence_summary"],
        "properties": {
          "achievement_id": { "type": "string" },
          "title": { "type": "string" },
          "tier": { "enum": ["bronze", "silver", "gold"] },
          "points": { "enum": [10, 30, 100] },
          "human_feedback": { "type": "string", "maxLength": 600 },
          "evidence_summary": { "type": "string", "maxLength": 600 },
          "awarded_by": { "enum": ["human", "system"] },
          "source_skill": { "type": "string", "maxLength": 128 }
        }
      }
    },
    "tracked": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["achievement_id", "title", "tier", "points", "progress", "encouragement", "guardrails"],
        "properties": {
          "achievement_id": { "type": "string" },
          "title": { "type": "string" },
          "tier": { "enum": ["bronze", "silver", "gold"] },
          "points": { "enum": [10, 30, 100] },
          "progress": {
            "type": "object",
            "additionalProperties": false,
            "required": ["current", "target", "unit"],
            "properties": {
              "current": { "type": "integer", "minimum": 0 },
              "target": { "type": "integer", "minimum": 1 },
              "unit": { "enum": ["events", "qualified_tasks", "distinct_runs"] }
            }
          },
          "encouragement": { "type": "string", "maxLength": 400 },
          "next_opportunity": { "type": "string", "maxLength": 400 },
          "guardrails": { "type": "array", "maxItems": 8, "items": { "type": "string" } }
        }
      }
    },
    "design_requests": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["request_id", "brief"],
        "properties": {
          "request_id": { "type": "string" },
          "brief": { "type": "string", "maxLength": 1000 }
        }
      }
    },
    "diagnostic_requests": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["request_id", "reason"],
        "properties": {
          "request_id": { "type": "string" },
          "reason": { "enum": ["first_run", "skills_changed", "manual"] }
        }
      }
    },
    "operating_priority": {
      "const": ["current_user_instruction", "safety_and_project_rules", "task_correctness", "tracked_achievements"]
    }
  }
}
