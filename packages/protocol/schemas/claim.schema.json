{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-achievements.dev/schemas/v1/claim.schema.json",
  "title": "Achievement claim",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "claim_id", "achievement_id", "agent_id", "task_ids", "summary", "evidence"],
  "properties": {
    "schema_version": { "const": "agent-achievements/v1" },
    "claim_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$" },
    "achievement_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
    "agent_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "task_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "maxLength": 128 } },
    "summary": { "type": "string", "minLength": 1, "maxLength": 800 },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "$ref": "event.schema.json#/$defs/evidence" }
    }
  }
}

