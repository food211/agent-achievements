{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-achievements.dev/schemas/v1/prompt-ack.schema.json",
  "title": "Prompt injection acknowledgement from a Code Agent adapter",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "status", "observed_at"],
  "properties": {
    "schema_version": { "const": "agent-achievements/v1" },
    "request_id": { "type": "string", "pattern": "^prompt-[a-z0-9-]{4,80}$" },
    "status": { "enum": ["accepted", "delivered", "failed", "unsupported"] },
    "detail": { "type": "string", "maxLength": 600 },
    "observed_at": { "type": "string", "format": "date-time" }
  }
}
