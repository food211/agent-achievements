{
  "name": "agent-achievements",
  "version": "0.1.0",
  "private": true,
  "description": "A portable Wuxing rule-audit and recognition companion for Code Agents.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@agent-achievements/demo",
    "companion": "npm run start --workspace=@agent-achievements/companion",
    "install:skills": "node scripts/install-agent-skills.mjs",
    "wuxing": "npm run start --workspace=@agent-achievements/wuxing-service",
    "wuxing:dev": "npm run dev --workspace=@agent-achievements/wuxing-assistant",
    "build": "npm run build --workspaces --if-present",
    "test": "node --test tests/*.test.mjs",
    "validate": "npm run test && npm run build"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
