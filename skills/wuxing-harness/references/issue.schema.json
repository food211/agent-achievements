{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wuxing-harness.local/issue.schema.json",
  "title": "Wuxing Harness issue encounter",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "details", "impact_scope", "reversibility", "status"],
  "properties": {
    "issue_id": { "type": "string", "minLength": 2, "maxLength": 128 },
    "fingerprint": { "type": "string", "minLength": 2, "maxLength": 240 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 240 },
    "details": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "impact_scope": { "enum": ["low", "medium", "high"] },
    "reversibility": { "enum": ["reversible", "costly", "irreversible"] },
    "status": { "enum": ["observed", "waiting_human", "resolved"] },
    "source_ref": { "type": "string", "maxLength": 1000 }
  }
}
