{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wuxing-harness.local/coaching-observation.schema.json",
  "title": "Wuxing Harness coaching prework",
  "type": "object",
  "additionalProperties": false,
  "required": ["step_id", "summary", "candidates"],
  "properties": {
    "observation_id": { "type": "string", "minLength": 2, "maxLength": 128 },
    "step_id": { "type": "string", "minLength": 2, "maxLength": 128 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "candidates": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "source_ref", "evidence", "confidence"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "label": { "type": "string", "minLength": 1, "maxLength": 500 },
          "source_ref": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "evidence": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "confidence": { "enum": ["high", "medium", "low", "unknown"] }
        }
      }
    }
  }
}
