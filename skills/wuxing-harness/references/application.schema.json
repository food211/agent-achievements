{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/food211/agent-achievements/blob/main/skills/wuxing-harness/references/application.schema.json",
  "title": "Wuxing Harness Application",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "path", "before", "after", "validation"],
  "properties": {
    "schema_version": { "const": "wuxing-harness/v1" },
    "path": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "before": { "type": "string", "minLength": 1, "maxLength": 12000 },
    "after": { "type": "string", "minLength": 1, "maxLength": 12000 },
    "validation": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
    }
  }
}
